FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml .
RUN mkdir -p src/actas && touch src/actas/__init__.py && pip install --no-cache-dir -e ".[dev]"

CMD ["uvicorn", "actas.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
